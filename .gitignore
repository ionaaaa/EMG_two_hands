*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# Local EMG captures and training datasets
/apps/desktop/emg_live_marker/dataset/
/apps/desktop/emg_live_marker/recordings/
/apps/desktop/recordings/
/data/datasets/
/data/recordings/
*.bin

# Generated ML models and experiment outputs
/apps/desktop/models/
/apps/desktop/reports/
*.pt
*.ts

# Local logs and temporary files
*.log
*.tmp
*.temp
