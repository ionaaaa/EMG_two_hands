{
  "schema_version": 1,
  "course": {
    "id": "yucai",
    "name": "育才 EMG 双手手势课程",
    "language": "zh-CN"
  },
  "collection": {
    "actions": [
      {
        "id": "fist",
        "display_name_zh": "全力握拳"
      },
      {
        "id": "finger_spread",
        "display_name_zh": "五指完全张开"
      },
      {
        "id": "thumb_index_pinch",
        "display_name_zh": "拇食两指轻捏"
      }
    ],
    "trials_per_action": 10,
    "rest_before_s": 0.5,
    "hold_s": 1.5,
    "rest_after_s": 1.0,
    "trial_duration_s": 3.0,
    "randomize_action_order": true
  },
  "realtime_decoding": {
    "standard_teaching_model_path": "apps/desktop/models/effie_real_full_v2_continue/gesture_classifier.pt",
    "confidence_threshold": 0.7,
    "smoothing_frames": 5,
    "change_confirmations": 2
  },
  "personal_training": {
    "minimum_completed_trials_per_gesture": 5,
    "mode": "freeze_backbone",
    "epochs": 50,
    "batch_size": 128,
    "learning_rate": 0.0001,
    "device": "auto",
    "validation_split": "trial",
    "max_rest_ratio": 1.0,
    "seed": 42,
    "export_torchscript": false,
    "output_directory": "apps/desktop/models/student_personal"
  },
  "student_control_profiles": {
    "sensitivity": {
      "low": {
        "confidence_threshold": 0.8
      },
      "standard": {
        "confidence_threshold": 0.7
      },
      "high": {
        "confidence_threshold": 0.6
      }
    },
    "control_style": {
      "fast": {
        "smoothing_frames": 3,
        "change_confirmations": 1
      },
      "balanced": {
        "smoothing_frames": 5,
        "change_confirmations": 2
      },
      "stable": {
        "smoothing_frames": 7,
        "change_confirmations": 3
      }
    },
    "default": {
      "sensitivity": "standard",
      "control_style": "balanced"
    },
    "test_phase_duration_ms": 3000
  },
  "game": {
    "commands": {
      "A": {
        "display_name_zh": "红色音符/指令 A",
        "game_gesture": "fist"
      },
      "B": {
        "display_name_zh": "蓝色音符/指令 B",
        "game_gesture": "open-palm"
      },
      "none": {
        "display_name_zh": "无操作",
        "game_gesture": "rest"
      }
    },
    "default_mapping": {
      "fist": "A",
      "open-palm": "B",
      "rest": "none",
      "pinch": "none"
    },
    "gestures": [
      "fist",
      "open-palm"
    ],
    "rest": {
      "fixed": true,
      "action": "none"
    },
    "pinch": {
      "enabled_by_default": false,
      "participates_in_game": false
    }
  },
  "storage": {
    "classroom_id": "yucai_2026",
    "dataset_path": "data/datasets/{student_id}/{session_id}",
    "recording_path": "data/recordings/{recording_id}",
    "personal_model_path": "apps/desktop/models/{run_id}/gesture_classifier.ts",
    "competition_results_path": "apps/desktop/reports/teaching/yucai/{competition_id}/{student_id}"
  },
  "student_device_check": {
    "observe_duration_ms": 1500,
    "min_samples": 50,
    "min_rate_sps": 200.0,
    "max_rate_sps": 300.0,
    "max_rate_spread_sps": 40.0,
    "flat_channel_std_uv": 0.5,
    "max_abs_value_uv": 20000.0,
    "abnormal_percentile": 99.5,
    "max_abnormal_sample_ratio": 0.01,
    "max_consecutive_abnormal_ms": 40.0,
    "trial_min_sample_ratio": 0.8
  },
  "student_mode": {
    "student": {
      "student_id": "",
      "display_name": ""
    },
    "allowed_fields": [
      "student.student_id",
      "student.display_name",
      "collection.trials_per_action"
    ],
    "locked_fields": [
      "schema_version",
      "course.id",
      "course.language",
      "collection.actions",
      "collection.rest_before_s",
      "collection.hold_s",
      "collection.rest_after_s",
      "collection.trial_duration_s",
      "collection.randomize_action_order",
      "realtime_decoding.standard_teaching_model_path",
      "realtime_decoding.confidence_threshold",
      "realtime_decoding.smoothing_frames",
      "realtime_decoding.change_confirmations",
      "personal_training",
      "student_control_profiles",
      "game.gestures",
      "game.commands",
      "game.default_mapping",
      "game.rest",
      "game.pinch",
      "storage"
    ]
  }
}
